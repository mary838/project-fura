# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored (see .gitignore's ".env*" rule) — never commit real secrets.

# SMTP credentials used to send the contact-form notification. Server-side
# only — do NOT prefix any of these with NEXT_PUBLIC_.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Where contact-form submissions are delivered. Fixed server-side so the
# endpoint can't be used as an open relay to an attacker-chosen address.
CONTACT_RECEIVER_EMAIL=

# Cloudflare Turnstile secret key (server-side verification).
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key. This one IS meant to be public — it's
# embedded in the widget script that runs in the browser, unlike the keys
# above, so NEXT_PUBLIC_ is correct here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
